{
  "name": "@factlayer/mcp-server",
  "version": "0.7.0",
  "description": "Exposes FactLayer's freshness checks as MCP tools (check_freshness, mark_verified, scan_mem0_freshness, scan_zep_freshness, scan_cognee_freshness).",
  "keywords": ["ai", "agent-memory", "llm", "freshness", "mcp", "factlayer"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "factlayer-mcp": "./dist/index.js"
  },
  "scripts": {
    "test": "bun test",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "bun run ../../scripts/check-publish-ready.ts"
  },
  "dependencies": {
    "@factlayer/adapter-cognee": "workspace:*",
    "@factlayer/adapter-mem0": "workspace:*",
    "@factlayer/adapter-zep": "workspace:*",
    "@factlayer/core": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
